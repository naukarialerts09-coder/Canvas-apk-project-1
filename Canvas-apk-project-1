<!DOCTYPE html>
<html lang="mr" class="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>AstroAI - AI आधारित वैदिक ज्योतिष, Kundli & Partner Profile Chatbot</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    colors: {
                        cosmic: {
                            900: '#0B091A',
                            800: '#151233',
                            700: '#211C4D',
                            600: '#322B73',
                            gold: '#F59E0B',
                            goldLight: '#FBBF24',
                            amberDark: '#B45309'
                        }
                    }
                }
            }
        }
    </script>
    <!-- FontAwesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&family=Tiro+Devanagari+Marathi:ital@0;1&display=swap" rel="stylesheet">
    <style>
        body {
            font-family: 'Poppins', 'Tiro Devanagari Marathi', sans-serif;
        }
        .starry-bg {
            background-color: #0b091a;
            background-image: radial-gradient(white, rgba(255,255,255,.2) 2px, transparent 40px),
                              radial-gradient(white, rgba(255,255,255,.15) 1px, transparent 30px),
                              radial-gradient(white, rgba(255,255,255,.1) 2px, transparent 40px);
            background-size: 550px 550px, 350px 350px, 250px 250px;
            background-position: 0 0, 40px 60px, 130px 270px;
        }
        .gold-gradient-text {
            background: linear-gradient(135deg, #FCD34D 0%, #F59E0B 50%, #D97706 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }
        /* Glassmorphism */
        .glass-card {
            background: rgba(21, 18, 51, 0.78);
            backdrop-filter: blur(12px);
            border: 1px solid rgba(245, 158, 11, 0.2);
        }
        .light .glass-card {
            background: rgba(255, 255, 255, 0.92);
            border: 1px solid rgba(217, 119, 6, 0.25);
        }
    </style>
</head>
<body class="starry-bg text-slate-100 min-h-screen flex flex-col transition-colors duration-300">

    <!-- Header / Navbar -->
    <header class="sticky top-0 z-50 glass-card border-b border-amber-500/20 px-4 py-3 shadow-lg">
        <div class="max-w-7xl mx-auto flex justify-between items-center">
            <!-- Logo & Dynamic Today Date -->
            <div class="flex items-center space-x-3 cursor-pointer" onclick="switchTab('kundli')">
                <div class="w-10 h-10 rounded-full bg-gradient-to-tr from-amber-500 to-purple-700 flex items-center justify-center shadow-md shadow-amber-500/30">
                    <i class="fa-solid font-bold text-amber-200 text-xl fa-om"></i>
                </div>
                <div>
                    <h1 class="text-xl font-bold tracking-wide gold-gradient-text">AstroAI</h1>
                    <p class="text-[10px] text-amber-300/80 tracking-wider font-semibold uppercase">Vedic Astrology & Partner AI</p>
                </div>
            </div>

            <!-- Navigation Links (Desktop) -->
            <nav class="hidden md:flex space-x-1 lg:space-x-2 text-sm font-medium">
                <button onclick="switchTab('kundli')" id="nav-kundli" class="nav-btn active-nav px-3 py-2 rounded-lg transition-all flex items-center space-x-2 bg-amber-500/20 text-amber-300 border border-amber-500/30">
                    <i class="fa-solid fa-dharmachakra"></i>
                    <span data-i18n="nav_kundli">जन्मकुंडली</span>
                </button>
                <button onclick="switchTab('chat')" id="nav-chat" class="nav-btn px-3 py-2 rounded-lg transition-all flex items-center space-x-2 text-slate-300 hover:text-amber-300 hover:bg-white/5">
                    <i class="fa-solid fa-robot text-amber-400"></i>
                    <span data-i18n="nav_chat">AI ज्योतिषी चॅट</span>
                </button>
                <button onclick="switchTab('horoscope')" id="nav-horoscope" class="nav-btn px-3 py-2 rounded-lg transition-all flex items-center space-x-2 text-slate-300 hover:text-amber-300 hover:bg-white/5">
                    <i class="fa-solid fa-sun text-yellow-400"></i>
                    <span data-i18n="nav_horoscope">राशीभविष्य</span>
                </button>
                <button onclick="switchTab('analysis')" id="nav-analysis" class="nav-btn px-3 py-2 rounded-lg transition-all flex items-center space-x-2 text-slate-300 hover:text-amber-300 hover:bg-white/5">
                    <i class="fa-solid fa-chart-pie text-emerald-400"></i>
                    <span data-i18n="nav_analysis">जीवन विश्लेषण</span>
                </button>
                <button onclick="switchTab('matchmaking')" id="nav-matchmaking" class="nav-btn px-3 py-2 rounded-lg transition-all flex items-center space-x-2 text-slate-300 hover:text-amber-300 hover:bg-white/5">
                    <i class="fa-solid fa-heart text-pink-400"></i>
                    <span data-i18n="nav_match">गुण जुळवणी</span>
                </button>
                <button onclick="switchTab('panchang')" id="nav-panchang" class="nav-btn px-3 py-2 rounded-lg transition-all flex items-center space-x-2 text-slate-300 hover:text-amber-300 hover:bg-white/5">
                    <i class="fa-solid fa-calendar-days text-indigo-400"></i>
                    <span data-i18n="nav_panchang">पंचांग व अंकशास्त्र</span>
                </button>
            </nav>

            <!-- Actions: Today Date Pill, User Details Trigger, Theme -->
            <div class="flex items-center space-x-2">
                <!-- Today's Date Pill Badge -->
                <div class="hidden sm:flex items-center space-x-1.5 px-3 py-1.5 rounded-full bg-cosmic-800 border border-amber-500/30 text-amber-300 text-xs shadow-inner">
                    <i class="fa-regular fa-calendar-check text-amber-400"></i>
                    <span id="header-today-date" class="font-medium">आज: 25 ऑगस्ट 2026</span>
                </div>

                <!-- User Profile / Edit Details Trigger -->
                <button onclick="openBirthModal('user')" class="px-3 py-1.5 text-xs rounded-full border border-amber-500/40 bg-amber-500/10 text-amber-300 hover:bg-amber-500/20 flex items-center space-x-1.5 transition">
                    <i class="fa-solid fa-user-pen"></i>
                    <span id="header-user-name" class="font-medium max-w-[90px] truncate">माझे प्रोफाइल</span>
                </button>

                <!-- Language Selector -->
                <select id="lang-selector" onchange="changeLanguage(this.value)" class="bg-cosmic-800 text-amber-300 border border-amber-500/30 text-xs rounded-lg px-2 py-1.5 focus:outline-none focus:border-amber-400 cursor-pointer">
                    <option value="mr">मराठी</option>
                    <option value="hi">हिंदी</option>
                    <option value="en">English</option>
                </select>

                <!-- Theme Toggle -->
                <button onclick="toggleTheme()" class="w-8 h-8 rounded-full bg-cosmic-800 border border-amber-500/30 flex items-center justify-center text-amber-300 hover:bg-amber-500/20 transition">
                    <i id="theme-icon" class="fa-solid fa-moon"></i>
                </button>
            </div>
        </div>

        <!-- Mobile Navigation Sub-bar -->
        <div class="flex md:hidden overflow-x-auto space-x-2 pt-2 border-t border-amber-500/10 mt-2 text-xs">
            <button onclick="switchTab('kundli')" id="nav-mob-kundli" class="px-3 py-1.5 rounded-full whitespace-nowrap bg-amber-500/20 text-amber-300 border border-amber-500/30">जन्मकुंडली</button>
            <button onclick="switchTab('chat')" id="nav-mob-chat" class="px-3 py-1.5 rounded-full whitespace-nowrap text-slate-300 hover:bg-white/10">AI चॅट</button>
            <button onclick="switchTab('horoscope')" id="nav-mob-horoscope" class="px-3 py-1.5 rounded-full whitespace-nowrap text-slate-300 hover:bg-white/10">राशीभविष्य</button>
            <button onclick="switchTab('analysis')" id="nav-mob-analysis" class="px-3 py-1.5 rounded-full whitespace-nowrap text-slate-300 hover:bg-white/10">विश्लेषण</button>
            <button onclick="switchTab('matchmaking')" id="nav-mob-matchmaking" class="px-3 py-1.5 rounded-full whitespace-nowrap text-slate-300 hover:bg-white/10">गुण जुळवणी</button>
            <button onclick="switchTab('panchang')" id="nav-mob-panchang" class="px-3 py-1.5 rounded-full whitespace-nowrap text-slate-300 hover:bg-white/10">पंचांग</button>
        </div>
    </header>

    <!-- Main Content Container -->
    <main class="flex-grow max-w-7xl w-full mx-auto p-4 md:p-6 space-y-6">

        <!-- TODAY'S DATE & PANCHANG SUMMARY BAR (HOME DASHBOARD BANNER) -->
        <div class="glass-card p-4 rounded-2xl border border-amber-500/30 bg-gradient-to-r from-cosmic-800 via-cosmic-700 to-purple-900/50 flex flex-col md:flex-row justify-between items-start md:items-center gap-4 shadow-xl">
            <div class="flex items-center space-x-3">
                <div class="w-12 h-12 rounded-xl bg-gradient-to-tr from-amber-500 to-amber-600 text-cosmic-900 flex flex-col items-center justify-center font-bold shadow-md">
                    <span id="date-card-daynum" class="text-lg leading-none">25</span>
                    <span id="date-card-month" class="text-[10px] uppercase font-semibold">ऑगस्ट</span>
                </div>
                <div>
                    <div class="flex items-center space-x-2">
                        <h2 id="date-card-full" class="text-base font-bold text-white">मंगळवार, 25 ऑगस्ट 2026</h2>
                        <span class="text-[11px] px-2 py-0.5 rounded-full bg-amber-500/20 text-amber-300 border border-amber-500/30">आजची तिथी</span>
                    </div>
                    <p id="date-card-panchang-quick" class="text-xs text-slate-300 mt-0.5">
                        <i class="fa-solid fa-moon text-amber-400 mr-1"></i>शुक्ल पक्ष एकादशी | नक्षत्र: रोहिणी | शुभ वेळ: 12:05 PM - 12:55 PM
                    </p>
                </div>
            </div>

            <!-- Profile View Toggle (User vs Partner) -->
            <div class="flex items-center space-x-2 bg-cosmic-900/90 p-1.5 rounded-xl border border-amber-500/30 text-xs">
                <button onclick="setActiveProfile('user')" id="profile-toggle-user" class="px-3 py-1.5 rounded-lg font-semibold bg-gradient-to-r from-amber-500 to-amber-600 text-cosmic-900 shadow">
                    <i class="fa-solid fa-user mr-1"></i>माझी कुंडली
                </button>
                <button onclick="setActiveProfile('partner')" id="profile-toggle-partner" class="px-3 py-1.5 rounded-lg font-semibold text-slate-300 hover:text-white">
                    <i class="fa-solid fa-heart text-pink-400 mr-1"></i>जोडीदाराची कुंडली
                </button>
            </div>
        </div>

        <!-- ==================== TAB 1: KUNDLI & PROFILES ==================== -->
        <section id="tab-kundli" class="tab-content space-y-6">
            
            <!-- User & Partner Profiles Grid -->
            <div class="grid grid-cols-1 md:grid-cols-12 gap-6">
                
                <!-- Main Active Profile Card (7 Cols) -->
                <div class="md:col-span-7 glass-card rounded-2xl p-6 shadow-xl border border-amber-500/30 relative overflow-hidden flex flex-col justify-between">
                    <div class="absolute -right-10 -bottom-10 w-40 h-40 bg-amber-500/10 rounded-full blur-3xl pointer-events-none"></div>
                    <div>
                        <div class="flex justify-between items-start gap-2">
                            <div>
                                <div class="flex items-center space-x-3">
                                    <h2 id="summary-name" class="text-2xl font-bold text-white">राहुल शर्मा</h2>
                                    <span id="summary-badge-type" class="text-xs px-2.5 py-0.5 rounded-full bg-amber-500/20 text-amber-300 border border-amber-500/30 font-medium">माझे प्रोफाइल</span>
                                    <span id="summary-gender" class="text-xs px-2 py-0.5 rounded-full bg-purple-500/20 text-purple-300 border border-purple-500/30">पुरुष</span>
                                </div>
                                <p class="text-xs text-slate-300 mt-2 flex flex-wrap gap-x-4 gap-y-1">
                                    <span><i class="fa-regular fa-calendar text-amber-400 mr-1"></i><span id="summary-dob">15 ऑगस्ट 1995</span></span>
                                    <span><i class="fa-regular fa-clock text-amber-400 mr-1"></i><span id="summary-tob">14:30:00</span></span>
                                    <span><i class="fa-solid fa-location-dot text-amber-400 mr-1"></i><span id="summary-place">पुणे, महाराष्ट्र</span></span>
                                </p>
                            </div>
                            <button onclick="openBirthModal(currentActiveProfile)" class="px-3 py-1.5 bg-gradient-to-r from-amber-500 to-amber-600 hover:from-amber-600 hover:to-amber-700 text-cosmic-900 font-semibold rounded-xl text-xs shadow-md transition flex items-center space-x-1 shrink-0">
                                <i class="fa-solid fa-pen-to-square"></i>
                                <span>माहिती बदला</span>
                            </button>
                        </div>
                    </div>

                    <!-- Profile Quick Astrology Chips -->
                    <div class="grid grid-cols-2 sm:grid-cols-4 gap-2 mt-6">
                        <div class="bg-cosmic-900/80 p-2.5 rounded-xl text-center border border-amber-500/20">
                            <span class="text-[10px] text-amber-300/80 block uppercase">लग्न राशी</span>
                            <span id="card-lagna" class="text-xs font-bold text-white mt-0.5 block">वृश्चिक</span>
                        </div>
                        <div class="bg-cosmic-900/80 p-2.5 rounded-xl text-center border border-purple-500/20">
                            <span class="text-[10px] text-amber-300/80 block uppercase">चंद्र राशी</span>
                            <span id="card-moon" class="text-xs font-bold text-white mt-0.5 block">मीन</span>
                        </div>
                        <div class="bg-cosmic-900/80 p-2.5 rounded-xl text-center border border-yellow-500/20">
                            <span class="text-[10px] text-amber-300/80 block uppercase">सूर्य राशी</span>
                            <span id="card-sun" class="text-xs font-bold text-white mt-0.5 block">सिंह</span>
                        </div>
                        <div class="bg-cosmic-900/80 p-2.5 rounded-xl text-center border border-emerald-500/20">
                            <span class="text-[10px] text-amber-300/80 block uppercase">नक्षत्र</span>
                            <span id="card-nakshatra" class="text-xs font-bold text-white mt-0.5 block">रेवती (2)</span>
                        </div>
                    </div>
                </div>

                <!-- Dedicated Partner Profile Shortcut Card (5 Cols) -->
                <div class="md:col-span-5 glass-card rounded-2xl p-6 border border-pink-500/30 bg-gradient-to-b from-cosmic-800 to-pink-950/20 flex flex-col justify-between space-y-4 shadow-xl">
                    <div class="flex justify-between items-start">
                        <div class="flex items-center space-x-3">
                            <div class="w-10 h-10 rounded-full bg-pink-500/20 border border-pink-500/50 flex items-center justify-center text-pink-400 font-bold">
                                <i class="fa-solid fa-heart"></i>
                            </div>
                            <div>
                                <h3 class="font-bold text-white text-base flex items-center space-x-2">
                                    <span id="partner-card-name">प्रिया पाटील</span>
                                    <span class="text-[10px] px-2 py-0.5 rounded-full bg-pink-500/20 text-pink-300 border border-pink-500/30">जोडीदार</span>
                                </h3>
                                <p class="text-xs text-pink-200/80" id="partner-card-dob">२० नोव्हेंबर १९९७ (कर्क राशी)</p>
                            </div>
                        </div>
                        <button onclick="openBirthModal('partner')" class="text-xs px-2.5 py-1 rounded-lg bg-pink-500/20 hover:bg-pink-500/30 text-pink-300 border border-pink-500/30 transition">
                            <i class="fa-solid fa-user-pen"></i> बदला
                        </button>
                    </div>

                    <div class="p-3 bg-cosmic-900/90 rounded-xl border border-pink-500/20 text-xs space-y-1.5">
                        <div class="flex justify-between text-slate-300">
                            <span>नक्षत्र:</span>
                            <span class="font-semibold text-pink-300" id="partner-card-nakshatra">पुष्य (चरण 3)</span>
                        </div>
                        <div class="flex justify-between text-slate-300">
                            <span>अष्टकूट मिलन गुण:</span>
                            <span class="font-bold text-emerald-400">28 / 36 (उत्तम)</span>
                        </div>
                    </div>

                    <div class="grid grid-cols-2 gap-2">
                        <button onclick="switchTab('matchmaking')" class="py-2 bg-pink-600/30 hover:bg-pink-600/50 text-pink-200 border border-pink-500/40 font-semibold rounded-xl text-xs transition flex items-center justify-center space-x-1">
                            <i class="fa-solid fa-ring"></i>
                            <span>गुण मिलान</span>
                        </button>
                        <button onclick="askPartnerAI()" class="py-2 bg-purple-600/30 hover:bg-purple-600/50 text-purple-200 border border-purple-500/40 font-semibold rounded-xl text-xs transition flex items-center justify-center space-x-1">
                            <i class="fa-solid fa-comments"></i>
                            <span>AI जोडीदार सल्ला</span>
                        </button>
                    </div>
                </div>
            </div>

            <!-- Main Kundli Chart & Planetary Table -->
            <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">
                <!-- North Indian Kundli Visualizer (7 Columns) -->
                <div class="lg:col-span-7 glass-card rounded-2xl p-5 border border-amber-500/20 flex flex-col items-center">
                    <div class="w-full flex justify-between items-center mb-4">
                        <h3 class="text-lg font-semibold text-amber-300 flex items-center space-x-2">
                            <i class="fa-solid fa-dharmachakra"></i>
                            <span id="chart-title-text" data-i18n="north_kundli_title">लग्न कुंडली (North Indian Chart)</span>
                        </h3>
                        <span class="text-xs bg-purple-900/60 text-purple-200 px-3 py-1 rounded-full border border-purple-500/40">Lahiri Ayanamsa</span>
                    </div>

                    <!-- SVG Kundli Chart -->
                    <div class="w-full max-w-md aspect-square relative bg-cosmic-900/90 rounded-xl p-2 border border-amber-500/40 shadow-inner">
                        <svg viewBox="0 0 400 400" class="w-full h-full text-amber-400">
                            <!-- Outer Frame -->
                            <rect x="10" y="10" width="380" height="380" fill="none" stroke="currentColor" stroke-width="2"/>
                            <!-- Inner Diagonals -->
                            <line x1="10" y1="10" x2="390" y2="390" stroke="currentColor" stroke-width="1.5" stroke-dasharray="3 3"/>
                            <line x1="390" y1="10" x2="10" y2="390" stroke="currentColor" stroke-width="1.5" stroke-dasharray="3 3"/>
                            <!-- Inner Diamond -->
                            <polygon points="200,10 390,200 200,390 10,200" fill="none" stroke="currentColor" stroke-width="2"/>

                            <!-- House Numbers & Planets Containers -->
                            <!-- House 1 (Top Center) -->
                            <text x="200" y="70" text-anchor="middle" fill="#fbbf24" font-size="12" font-weight="bold" id="h1-num">1</text>
                            <text x="200" y="110" text-anchor="middle" fill="#ffffff" font-size="13" font-weight="bold" id="h1-planets">सू, बु</text>

                            <!-- House 2 (Top Left) -->
                            <text x="110" y="45" text-anchor="middle" fill="#fbbf24" font-size="12" font-weight="bold" id="h2-num">2</text>
                            <text x="100" y="80" text-anchor="middle" fill="#ffffff" font-size="12" id="h2-planets">शु</text>

                            <!-- House 3 (Left Top) -->
                            <text x="45" y="110" text-anchor="middle" fill="#fbbf24" font-size="12" font-weight="bold" id="h3-num">3</text>
                            <text x="70" y="140" text-anchor="middle" fill="#ffffff" font-size="12" id="h3-planets">रा</text>

                            <!-- House 4 (Center Left) -->
                            <text x="100" y="200" text-anchor="middle" fill="#fbbf24" font-size="12" font-weight="bold" id="h4-num">4</text>
                            <text x="110" y="225" text-anchor="middle" fill="#ffffff" font-size="13" font-weight="bold" id="h4-planets">चं</text>

                            <!-- House 5 (Left Bottom) -->
                            <text x="45" y="290" text-anchor="middle" fill="#fbbf24" font-size="12" font-weight="bold" id="h5-num">5</text>
                            <text x="70" y="260" text-anchor="middle" fill="#ffffff" font-size="12" id="h5-planets">-</text>

                            <!-- House 6 (Bottom Left) -->
                            <text x="110" y="355" text-anchor="middle" fill="#fbbf24" font-size="12" font-weight="bold" id="h6-num">6</text>
                            <text x="100" y="320" text-anchor="middle" fill="#ffffff" font-size="12" id="h6-planets">गु</text>

                            <!-- House 7 (Bottom Center) -->
                            <text x="200" y="330" text-anchor="middle" fill="#fbbf24" font-size="12" font-weight="bold" id="h7-num">7</text>
                            <text x="200" y="295" text-anchor="middle" fill="#ffffff" font-size="13" font-weight="bold" id="h7-planets">के</text>

                            <!-- House 8 (Bottom Right) -->
                            <text x="290" y="355" text-anchor="middle" fill="#fbbf24" font-size="12" font-weight="bold" id="h8-num">8</text>
                            <text x="300" y="320" text-anchor="middle" fill="#ffffff" font-size="12" id="h8-planets">-</text>

                            <!-- House 9 (Right Bottom) -->
                            <text x="355" y="290" text-anchor="middle" fill="#fbbf24" font-size="12" font-weight="bold" id="h9-num">9</text>
                            <text x="330" y="260" text-anchor="middle" fill="#ffffff" font-size="12" id="h9-planets">मं</text>

                            <!-- House 10 (Center Right) -->
                            <text x="300" y="200" text-anchor="middle" fill="#fbbf24" font-size="12" font-weight="bold" id="h10-num">10</text>
                            <text x="290" y="225" text-anchor="middle" fill="#ffffff" font-size="13" font-weight="bold" id="h10-planets">श</text>

                            <!-- House 11 (Right Top) -->
                            <text x="355" y="110" text-anchor="middle" fill="#fbbf24" font-size="12" font-weight="bold" id="h11-num">11</text>
                            <text x="330" y="140" text-anchor="middle" fill="#ffffff" font-size="12" id="h11-planets">-</text>

                            <!-- House 12 (Top Right) -->
                            <text x="290" y="45" text-anchor="middle" fill="#fbbf24" font-size="12" font-weight="bold" id="h12-num">12</text>
                            <text x="300" y="80" text-anchor="middle" fill="#ffffff" font-size="12" id="h12-planets">-</text>
                        </svg>
                    </div>

                    <!-- Current Dasha Info Badge -->
                    <div class="mt-4 w-full bg-cosmic-800/80 p-3 rounded-xl border border-amber-500/30 flex justify-between items-center text-xs">
