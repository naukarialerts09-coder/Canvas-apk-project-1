        // ================= Astrology Computation =================
        function computeVedicAstrology(profileType) {
            const profile = (profileType === 'user') ? userState : partnerState;
            const dobDate = new Date(profile.dob + 'T' + profile.tob);
            const year = dobDate.getFullYear();
            const hours = dobDate.getHours() + dobDate.getMinutes()/60;
            const dayOfYear = Math.floor((dobDate - new Date(year, 0, 0)) / (1000 * 60 * 60 * 24));

            let sunLon = (dayOfYear * 0.9856 + 280) % 360;
            let moonLon = (dayOfYear * 13.176 + (hours * 0.55) + (profileType === 'user' ? 45 : 100)) % 360;
            let lagnaLon = (hours * 15 + profile.lon + (dayOfYear * 0.9856)) % 360;

            const lagnaIndex = Math.floor(lagnaLon / 30);
            const moonIndex = Math.floor(moonLon / 30);
            const sunIndex = Math.floor(sunLon / 30);

            const nakIndex = Math.floor(moonLon / (360 / 27));
            const pada = Math.floor((moonLon % (360 / 27)) / (360 / 108)) + 1;

            const resData = {
                lagna: ZODIAC_SIGNS[lagnaIndex],
                lagnaIdx: lagnaIndex + 1,
                moonSign: ZODIAC_SIGNS[moonIndex],
                sunSign: ZODIAC_SIGNS[sunIndex],
                nakshatra: NAKSHATRAS[nakIndex],
                pada: pada,
                planets: [
                    { name: "सूर्य (Sun)", sign: ZODIAC_SIGNS[sunIndex], degree: (sunLon % 30).toFixed(2) + "°", house: ((sunIndex - lagnaIndex + 12) % 12) + 1, retro: false },
                    { name: "चंद्र (Moon)", sign: ZODIAC_SIGNS[moonIndex], degree: (moonLon % 30).toFixed(2) + "°", house: ((moonIndex - lagnaIndex + 12) % 12) + 1, retro: false },
                    { name: "मंगळ (Mars)", sign: ZODIAC_SIGNS[(lagnaIndex + 2) % 12], degree: "14.22°", house: 3, retro: false },
                    { name: "बुध (Mercury)", sign: ZODIAC_SIGNS[sunIndex], degree: "08.15°", house: 1, retro: true },
                    { name: "गुरु (Jupiter)", sign: ZODIAC_SIGNS[(lagnaIndex + 5) % 12], degree: "19.40°", house: 6, retro: false },
                    { name: "शुक्र (Venus)", sign: ZODIAC_SIGNS[(lagnaIndex + 1) % 12], degree: "25.08°", house: 2, retro: false },
                    { name: "शनी (Saturn)", sign: ZODIAC_SIGNS[(lagnaIndex + 9) % 12], degree: "11.50°", house: 10, retro: false },
                    { name: "राहू (Rahu)", sign: ZODIAC_SIGNS[(lagnaIndex + 3) % 12], degree: "04.12°", house: 4, retro: true },
                    { name: "केतू (Ketu)", sign: ZODIAC_SIGNS[(lagnaIndex + 9) % 12], degree: "04.12°", house: 10, retro: true }
                ]
            };

            if (profileType === 'user') calculatedKundliUser = resData;
            else calculatedKundliPartner = resData;
        }

