            sendQuickPrompt(`माझ्या (${userState.name}) आणि माझ्या जोडीदाराच्या (${partnerState.name}) कुंडलीनुसार आमचे भविष्य आणि सुसंवाद कसा राहील?`);
        }

        function handleChatKeyPress(e) {
            if (e.key === 'Enter') sendChatMessage();
        }

        function clearChatHistory() {
            const chatBox = document.getElementById('chat-box');
            chatBox.innerHTML = '';
            appendMessageUI("ai", "संभाषण साफ केले आहे. तुम्हाला काय विचारायचे आहे?");
        }

        // ================= Horoscope / Domain / Matchmaking Handlers =================
        function setHoroscopePeriod(period) {
            currentHoroscopePeriod = period;
            ['daily', 'weekly', 'monthly'].forEach(p => {
                const btn = document.getElementById(`btn-period-${p}`);
                if (p === period) btn.className = "px-3 py-1 rounded-lg bg-amber-500 text-cosmic-900 font-bold";
                else btn.className = "px-3 py-1 rounded-lg text-slate-300";
            });
            renderHoroscopeCards();
        }

        function updateHoroscopeView() { renderHoroscopeCards(); }

        function renderHoroscopeCards() {
            const container = document.getElementById('horoscope-cards-container');
            container.innerHTML = `
                <div class="glass-card p-4 rounded-xl border border-amber-500/20 space-y-2">
                    <div class="flex items-center space-x-2 text-amber-400 font-bold text-sm">
                        <i class="fa-solid fa-briefcase"></i>
                        <span>करिअर & नोकरी</span>
                    </div>
                    <p class="text-xs text-slate-300">आज कार्यक्षेत्रात नवीन जबाबदाऱ्या मिळतील. वरिष्ठांचे सहकार्य लाभेल आणि रखडलेली कामे पूर्ण होतील.</p>
                </div>
                <div class="glass-card p-4 rounded-xl border border-amber-500/20 space-y-2">
                    <div class="flex items-center space-x-2 text-pink-400 font-bold text-sm">
                        <i class="fa-solid fa-heart"></i>
                        <span>प्रेम & कुटुंब</span>
                    </div>
                    <p class="text-xs text-slate-300">जोडीदारासोबत संवादातून मतभेद दूर होतील. कौटुंबिक वातावरणात आनंदाचे क्षण अनुभवता येतील.</p>
                </div>
                <div class="glass-card p-4 rounded-xl border border-amber-500/20 space-y-2">
                    <div class="flex items-center space-x-2 text-yellow-400 font-bold text-sm">
                        <i class="fa-solid fa-coins"></i>
                        <span>आर्थिक स्थिती</span>
                    </div>
                    <p class="text-xs text-slate-300">धनागमनाचा चांगला योग आहे. नवीन गुंतवणुकीसाठी काळ अनुकूल असून आर्थिक लाभ संभवतो.</p>
                </div>
                <div class="glass-card p-4 rounded-xl border border-amber-500/20 space-y-2">
                    <div class="flex items-center space-x-2 text-emerald-400 font-bold text-sm">
                        <i class="fa-solid fa-heart-pulse"></i>
                        <span>आरोग्य & ऊर्जा</span>
                    </div>
                    <p class="text-xs text-slate-300">उत्तम शारीरिक ऊर्जा राहील. योगाभ्यास आणि संतुलित आहाराकडे लक्ष द्या.</p>
                </div>
            `;
        }

        function switchAnalysisDomain(domain) {
            activeDomain = domain;
            ['career', 'marriage', 'finance', 'health'].forEach(d => {
                const btn = document.getElementById(`domain-btn-${d}`);
                if (d === domain) btn.className = "p-4 rounded-xl border bg-amber-500/20 border-amber-500 text-amber-300 font-bold flex flex-col items-center justify-center space-y-2";
                else btn.className = "p-4 rounded-xl border border-amber-500/20 bg-cosmic-800 text-slate-300 hover:text-amber-300 font-bold flex flex-col items-center justify-center space-y-2";
            });
            renderDomainContent();
        }

        function renderDomainContent() {
            const box = document.getElementById('domain-content-box');
            let title = "", desc = "", upay = "";

            if (activeDomain === 'career') {
                title = "करिअर आणि कर्मभाव विश्लेषण (10th House Analysis)";
                desc = "कुंडलीत १० व्या भावात शनी स्थित असल्यामुळे ३० वयानंतर करिअर वेगाने उंचावेल.";
                upay = "प्रत्येक शनिवारी मारुती स्तोत्राचे पठण करा.";
            } else if (activeDomain === 'marriage') {
                title = "विवाह आणि सप्तम भाव विश्लेषण (7th House Analysis)";
                desc = "७ व्या भावाचा स्वामी सुस्थितीत असल्यामुळे तुमचा जोडीदार समजूतदार आणि गुणी असेल.";
                upay = "गुरुवारी विष्णू सहस्रनाम स्तोत्राचे पठण करावे.";
            } else if (activeDomain === 'finance') {
                title = "धन आणि द्वितीय/एकादश भाव विश्लेषण (Finance & Assets)";
                desc = "दुसऱ्या भावात शुक्र स्वराशीत असल्यामुळे तुमच्याकडे कायम धनसंचय राहील.";
                upay = "श्री सूक्ताचे दररोज पठण करणे फलदायी ठरेल.";
            } else {
                title = "आरोग्य आणि षष्ठ भाव विश्लेषण (Health & Vitality)";
                desc = "षष्ठ भावावर शुभ ग्रहांची दृष्टी असल्यामुळे तुमची प्रतिकारशक्ती उत्तम राहील.";
                upay = "सूर्याला दररोज सकाळी जल अर्पण करा.";
            }

            box.innerHTML = `
                <h3 class="text-lg font-bold text-amber-300">${title}</h3>
                <p class="text-xs text-slate-200 leading-relaxed">${desc}</p>
                <div class="p-3 bg-amber-500/10 border border-amber-500/30 rounded-lg text-xs">
                    <span class="font-bold text-amber-400">विशेष उपाय: </span>
                    <span class="text-amber-200">${upay}</span>
                </div>
            `;
        }

        function calculateMatchmaking() {
            const bName = document.getElementById('match-boy-name').value;
            const gName = document.getElementById('match-girl-name').value;
            document.getElementById('match-score').innerText = "28/36";
            document.getElementById('match-verdict').innerText = "उत्तम जुळवणी (Excellent Compatibility)";
            document.getElementById('match-desc').innerText = `${bName} आणि ${gName} यांच्या पत्रिकेत ३६ पैकी २८ गुण जुळत आहेत. नाडी दोष नसून वैवाहिक जीवनात परस्पर समंजसपणा आणि सुख-समृद्धी राहील.`;
        }

        // ================= Modal Functions for Birth Details =================
        function openBirthModal(targetProfile) {
            modalEditingProfile = targetProfile;
            const profile = (targetProfile === 'user') ? userState : partnerState;

            document.getElementById('modal-title-text').innerText = (targetProfile === 'user') ? "माझे जन्म तपशील बदला" : "जोडीदाराचे जन्म तपशील बदला";
            document.getElementById('input-name').value = profile.name;
            document.getElementById('input-gender').value = profile.gender;
            document.getElementById('input-dob').value = profile.dob;
            document.getElementById('input-tob').value = profile.tob;
            document.getElementById('input-lat').value = profile.lat;
            document.getElementById('input-lon').value = profile.lon;

            document.getElementById('birth-modal').classList.remove('hidden');
        }

        function closeBirthModal() {
            document.getElementById('birth-modal').classList.add('hidden');
        }

        function autoFillCoords(city) {
            const coords = {
                "Pune": { lat: 18.5204, lon: 73.8567 },
                "Mumbai": { lat: 19.0760, lon: 72.8777 },
                "Nagpur": { lat: 21.1458, lon: 79.0882 },
                "Nashik": { lat: 20.0059, lon: 73.7898 },
                "Delhi": { lat: 28.6139, lon: 77.2090 },
                "Bengaluru": { lat: 12.9716, lon: 77.5946 }
            };
            if (coords[city]) {
                document.getElementById('input-lat').value = coords[city].lat;
                document.getElementById('input-lon').value = coords[city].lon;
            }
        }

        function saveBirthDetails(e) {
            e.preventDefault();
            const target = (modalEditingProfile === 'user') ? userState : partnerState;

            target.name = document.getElementById('input-name').value;
            target.gender = document.getElementById('input-gender').value;
            target.dob = document.getElementById('input-dob').value;
            target.tob = document.getElementById('input-tob').value;
            target.place = document.getElementById('input-place').value;
            target.lat = parseFloat(document.getElementById('input-lat').value);
            target.lon = parseFloat(document.getElementById('input-lon').value);

            computeVedicAstrology(modalEditingProfile);
            renderActiveProfileView();
            closeBirthModal();
        }

        function changeLanguage(lang) {
            userState.lang = lang;
            updateUIStrings();
        }

        function updateUIStrings() {
            const lang = userState.lang;
            if (lang === 'en') {
                document.querySelectorAll('[data-i18n="nav_kundli"]').forEach(el => el.innerText = "Kundli");
                document.querySelectorAll('[data-i18n="nav_chat"]').forEach(el => el.innerText = "AI Chatbot");
                document.querySelectorAll('[data-i18n="nav_horoscope"]').forEach(el => el.innerText = "Horoscope");
                document.querySelectorAll('[data-i18n="nav_analysis"]').forEach(el => el.innerText = "Life Analysis");
                document.querySelectorAll('[data-i18n="nav_match"]').forEach(el => el.innerText = "Matchmaking");
                document.querySelectorAll('[data-i18n="nav_panchang"]').forEach(el => el.innerText = "Panchang");
            } else {
                document.querySelectorAll('[data-i18n="nav_kundli"]').forEach(el => el.innerText = "जन्मकुंडली");
                document.querySelectorAll('[data-i18n="nav_chat"]').forEach(el => el.innerText = "AI ज्योतिषी चॅट");
                document.querySelectorAll('[data-i18n="nav_horoscope"]').forEach(el => el.innerText = "राशीभविष्य");
                document.querySelectorAll('[data-i18n="nav_analysis"]').forEach(el => el.innerText = "जीवन विश्लेषण");
                document.querySelectorAll('[data-i18n="nav_match"]').forEach(el => el.innerText = "गुण जुळवणी");
                document.querySelectorAll('[data-i18n="nav_panchang"]').forEach(el => el.innerText = "पंचांग व अंकशास्त्र");
            }
        }

        function toggleTheme() {
            const html = document.documentElement;
            const icon = document.getElementById('theme-icon');
            if (html.classList.contains('dark')) {
                html.classList.remove('dark');
                html.classList.add('light');
                icon.className = "fa-solid fa-sun";
            } else {
                html.classList.remove('light');
                html.classList.add('dark');
                icon.className = "fa-solid fa-moon";
            }
        }
    </script>
